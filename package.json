{
  "name": "eventhub-playwright-automation",
  "version": "2.0.0",
  "private": true,
  "description": "EventHub end-to-end UI and OpenAPI-driven API automation",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:chromium": "playwright test --project=chromium",
    "test:browsers": "playwright test tests/ui --project=chromium --project=firefox --project=webkit",
    "test:headed": "playwright test --headed",
    "test:booking": "playwright test tests/ui/booking.spec.ts",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.15.0",
    "dotenv": "^16.5.0",
    "typescript": "^7.0.2"
  }
}
